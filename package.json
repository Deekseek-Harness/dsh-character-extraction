{
  "name": "character-extraction",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "character-extraction DSH skill 的辅助脚本（章节扫描、提取结果校验、实体卡/阶段卡汇总、版本备份与历史回滚）。Node 原生 TypeScript，无运行时依赖。",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "scan:chapters": "node .dsh/skills/character-extraction/scripts/scan_chapters.ts",
    "validate:extraction": "node .dsh/skills/character-extraction/scripts/validate_extraction.ts",
    "aggregate:cards": "node .dsh/skills/character-extraction/scripts/aggregate_cards.ts",
    "phase:plan": "node .dsh/skills/character-extraction/scripts/phase-plan.ts",
    "backup:output": "node .dsh/skills/character-extraction/scripts/backup_output.ts",
    "history": "node .dsh/skills/character-extraction/scripts/history.ts",
    "test": "node --test --test-isolation=none \".dsh/**/*.test.ts\"",
    "test:dot": "node --test --test-isolation=none --test-reporter=dot \".dsh/**/*.test.ts\"",
    "test:tsx": "tsx --test .dsh/skills/character-extraction/scripts/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}
